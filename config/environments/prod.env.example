# Deploy application images against isolated production infrastructure.
# This is a selector/endpoint template, not a complete secret inventory.
# Do not run prod using the local Compose demo/seed topology.
# Publish Web separately behind an HTTPS entrypoint; route same-origin /api/ to Gateway.
# Configure the Web proxy with a trusted Gateway CA chain and a TLS name matching its SAN.
FLOWDESK_ENVIRONMENT=prod
SPRING_PROFILES_ACTIVE=prod
FLOWDESK_NACOS_SERVER_ADDR=replace-with-production-nacos-address
FLOWDESK_NACOS_NAMESPACE=flowdesk-prod
FLOWDESK_NACOS_GROUP=FLOWDESK_GROUP
FLOWDESK_NACOS_USERNAME=flowdesk-prod
FLOWDESK_NACOS_PASSWORD=change-independent-production-application-password
FLOWDESK_IAM_DB_URL=replace-with-production-iam-jdbc-url
FLOWDESK_TICKET_DB_URL=replace-with-production-ticket-jdbc-url
FLOWDESK_WORKFLOW_DB_URL=replace-with-production-workflow-jdbc-url
FLOWDESK_ALERT_DB_URL=replace-with-production-alert-jdbc-url
FLOWDESK_NOTIFICATION_DB_URL=replace-with-production-notification-jdbc-url
FLOWDESK_NOTIFICATION_RECOVERY_DB_URL=replace-with-production-recovery-jdbc-url
FLOWDESK_REDIS_HOST=replace-with-production-redis-host
FLOWDESK_REDIS_PORT=6379
FLOWDESK_ROCKETMQ_NAME_SERVER=replace-with-production-rocketmq-nameserver
FLOWDESK_GATEWAY_TLS_ENABLED=true
FLOWDESK_GATEWAY_TLS_KEY_STORE=/run/secrets/flowdesk-gateway-tls.p12
FLOWDESK_GATEWAY_TLS_KEY_STORE_TYPE=PKCS12
# Supply the certificate password, JWT/DB/MQ/Redis credentials and token paths
# using the production secret provider; never store real values in this file.
