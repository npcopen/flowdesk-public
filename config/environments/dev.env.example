# Deployment selectors; merge into a separately generated .env based on .env.example.
FLOWDESK_ENVIRONMENT=dev
SPRING_PROFILES_ACTIVE=dev
FLOWDESK_NACOS_SERVER_ADDR=127.0.0.1:28848
FLOWDESK_NACOS_NAMESPACE=flowdesk-dev
FLOWDESK_NACOS_GROUP=FLOWDESK_GROUP
FLOWDESK_NACOS_USERNAME=flowdesk-dev
FLOWDESK_NACOS_PASSWORD=change-independent-dev-application-password
FLOWDESK_NACOS_HTTP_PUBLISH_PORT=28848
FLOWDESK_NACOS_GRPC_PUBLISH_PORT=29848
FLOWDESK_NACOS_CONSOLE_PUBLISH_PORT=28080
FLOWDESK_MYSQL_PORT=23306
FLOWDESK_REDIS_PUBLISH_PORT=26379
FLOWDESK_GATEWAY_PORT=8080
FLOWDESK_WEB_PORT=8086
# Web verifies Gateway TLS using FLOWDESK_GATEWAY_TLS_CA_FILE (public CA/certificate).
# FLOWDESK_GATEWAY_TLS_SERVER_NAME must match that certificate's SAN.
FLOWDESK_ROCKETMQ_NAMESERVER_PUBLISH_PORT=29876
FLOWDESK_ROCKETMQ_BROKER_VIP_PUBLISH_PORT=30909
FLOWDESK_ROCKETMQ_BROKER_PUBLISH_PORT=30911
FLOWDESK_ROCKETMQ_BROKER_HA_PUBLISH_PORT=30912
