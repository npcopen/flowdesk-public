# Deployment selectors; merge into an independently generated .env.test.
# Use a separate Compose project and fresh DB/MQ/Redis/JWT/TLS/Webhook credentials.
FLOWDESK_ENVIRONMENT=test
SPRING_PROFILES_ACTIVE=test
FLOWDESK_NACOS_SERVER_ADDR=127.0.0.1:38848
FLOWDESK_NACOS_NAMESPACE=flowdesk-test
FLOWDESK_NACOS_GROUP=FLOWDESK_GROUP
FLOWDESK_NACOS_USERNAME=flowdesk-test
FLOWDESK_NACOS_PASSWORD=change-independent-test-application-password
FLOWDESK_NACOS_HTTP_PUBLISH_PORT=38848
FLOWDESK_NACOS_GRPC_PUBLISH_PORT=39848
FLOWDESK_NACOS_CONSOLE_PUBLISH_PORT=38080
FLOWDESK_MYSQL_PORT=33306
FLOWDESK_REDIS_PUBLISH_PORT=36379
FLOWDESK_GATEWAY_PORT=18080
FLOWDESK_WEB_PORT=18086
# Set FLOWDESK_GATEWAY_TLS_CA_FILE to this environment's independent public CA/certificate.
# FLOWDESK_GATEWAY_TLS_SERVER_NAME must match that certificate's SAN.
FLOWDESK_ROCKETMQ_NAMESERVER_PUBLISH_PORT=39876
FLOWDESK_ROCKETMQ_BROKER_VIP_PUBLISH_PORT=40909
FLOWDESK_ROCKETMQ_BROKER_PUBLISH_PORT=40911
FLOWDESK_ROCKETMQ_BROKER_HA_PUBLISH_PORT=40912
