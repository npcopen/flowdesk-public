# Browser requests always use same-origin /api/v1. This value is only Vite's dev proxy target.
VITE_GATEWAY_DEV_URL=http://127.0.0.1:8080
VITE_DEV_PORT=5173

# M8 capabilities use the real Gateway by default. Set VITE_E2E_BACKEND=mock
# only for offline development or the local Playwright profile.
VITE_NOTIFICATION_MODE=api
VITE_RECOVERY_MODE=api
VITE_SLA_MODE=readonly-api
VITE_E2E_BACKEND=gateway
