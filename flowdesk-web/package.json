{
  "name": "flowdesk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:verified": "node ../scripts/build-web.mjs",
    "verify:artifact": "node ../scripts/verify-web-artifact.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:build": "node --test ../scripts/verify-web-artifact.test.mjs",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
