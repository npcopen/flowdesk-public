# Copy to .env and replace every placeholder with an independently generated secret.
# The database bootstrap rejects placeholder credentials; generate a local file with the provided script.
FLOWDESK_ENVIRONMENT=dev
# For host JVM launches; Compose sets the same profile from FLOWDESK_ENVIRONMENT.
SPRING_PROFILES_ACTIVE=dev
FLOWDESK_MYSQL_ROOT_PASSWORD=change-root-password
FLOWDESK_GATEWAY_DB_PASSWORD=change-gateway-db-password
FLOWDESK_IAM_DB_PASSWORD=change-iam-runtime-password
FLOWDESK_IAM_MIGRATOR_PASSWORD=change-iam-migrator-password
FLOWDESK_TICKET_DB_PASSWORD=change-ticket-runtime-password
FLOWDESK_TICKET_MIGRATOR_PASSWORD=change-ticket-migrator-password
FLOWDESK_WORKFLOW_DB_PASSWORD=change-workflow-runtime-password
FLOWDESK_WORKFLOW_MIGRATOR_PASSWORD=change-workflow-migrator-password
FLOWDESK_ALERT_DB_PASSWORD=change-alert-runtime-password
FLOWDESK_ALERT_MIGRATOR_PASSWORD=change-alert-migrator-password
FLOWDESK_ALERT_DB_MAXIMUM_POOL_SIZE=64
FLOWDESK_ALERT_DB_MINIMUM_IDLE=16
FLOWDESK_NOTIFICATION_DB_PASSWORD=change-notification-runtime-password
FLOWDESK_NOTIFICATION_MIGRATOR_PASSWORD=change-notification-migrator-password
FLOWDESK_NOTIFICATION_RECOVERY_DB_PASSWORD=change-notification-recovery-password
FLOWDESK_REDIS_PASSWORD=change-redis-password
FLOWDESK_NACOS_AUTH_TOKEN=change-base64-token-from-at-least-32-random-bytes
FLOWDESK_NACOS_IDENTITY_KEY=change-nacos-identity-key
FLOWDESK_NACOS_IDENTITY_VALUE=change-nacos-identity-value
FLOWDESK_NACOS_ADMIN_PASSWORD=change-nacos-admin-password
# Application account is separate from nacos admin; provisioned with namespace permissions.
FLOWDESK_NACOS_USERNAME=flowdesk-dev
FLOWDESK_NACOS_PASSWORD=change-independent-nacos-application-password
FLOWDESK_IAM_JWT_PRIVATE_KEY_FILE=change-iam-jwt-private-key-file
FLOWDESK_CURSOR_TOKEN_HMAC_KEY=change-cursor-token-hmac-key-base64-32-bytes
FLOWDESK_JWT_PUBLIC_KEY_FILE=change-jwt-public-key-file
FLOWDESK_MYSQL_PORT=3306
FLOWDESK_REDIS_PUBLISH_PORT=6379
FLOWDESK_NACOS_HTTP_PUBLISH_PORT=8848
FLOWDESK_NACOS_GRPC_PUBLISH_PORT=9848
FLOWDESK_NACOS_CONSOLE_PUBLISH_PORT=28080
# RocketMQ Broker publish values are also the listener targets. Keep the VIP
# port exactly two below the main listen port so NameServer routes stay valid.
FLOWDESK_ROCKETMQ_NAMESERVER_PUBLISH_PORT=9876
FLOWDESK_ROCKETMQ_BROKER_VIP_PUBLISH_PORT=10909
FLOWDESK_ROCKETMQ_BROKER_PUBLISH_PORT=10911
FLOWDESK_ROCKETMQ_BROKER_HA_PUBLISH_PORT=10912
FLOWDESK_NACOS_SERVER_ADDR=127.0.0.1:8848

# Managed profiles fix the namespace to flowdesk-dev / flowdesk-test / flowdesk-prod.
FLOWDESK_NACOS_NAMESPACE=flowdesk-dev
FLOWDESK_NACOS_GROUP=FLOWDESK_GROUP
FLOWDESK_NACOS_DISCOVERY_ENABLED=true
FLOWDESK_NACOS_REGISTER_ENABLED=true
# Synchronous service clients use OpenFeign and Nacos discovery when URLs are empty.
# Direct local debugging: IAM http://127.0.0.1:8081, Workflow http://127.0.0.1:8083.
# Inside Compose, direct URLs must use container hostnames (iam/workflow), not 127.0.0.1.
FLOWDESK_TICKET_IAM_BASE_URL=
FLOWDESK_TICKET_IAM_CONNECT_TIMEOUT=PT2S
FLOWDESK_TICKET_IAM_READ_TIMEOUT=PT3S
FLOWDESK_TICKET_WORKFLOW_BASE_URL=
FLOWDESK_TICKET_WORKFLOW_CONNECT_TIMEOUT=PT2S
FLOWDESK_TICKET_WORKFLOW_READ_TIMEOUT=PT3S
FLOWDESK_WORKFLOW_IAM_BASE_URL=
FLOWDESK_WORKFLOW_IAM_CONNECT_TIMEOUT=PT2S
FLOWDESK_WORKFLOW_IAM_READ_TIMEOUT=PT3S
FLOWDESK_GATEWAY_PORT=8080
# Independent browser entrypoint; Gateway remains the HTTPS API/Webhook endpoint.
FLOWDESK_WEB_PORT=8086
# Public CA/certificate used by Nginx to verify the Gateway TLS connection.
FLOWDESK_GATEWAY_TLS_CA_FILE=.data/keys/gateway.crt
FLOWDESK_GATEWAY_TLS_SERVER_NAME=localhost
FLOWDESK_IAM_PORT=8081
FLOWDESK_TICKET_PORT=8082
FLOWDESK_WORKFLOW_PORT=8083
FLOWDESK_ALERT_PORT=8084
FLOWDESK_NOTIFICATION_PORT=8085
FLOWDESK_ROCKETMQ_NAME_SERVER=127.0.0.1:9876
FLOWDESK_ROCKETMQ_BROKER_ADVERTISED_HOST=rocketmq-broker
FLOWDESK_ROCKETMQ_VERIFY_BROKER_HOST=rocketmq-broker
FLOWDESK_ROCKETMQ_ADMIN_BROKER_HOST=rocketmq-broker
FLOWDESK_ROCKETMQ_ACL_ENABLED=true
FLOWDESK_ROCKETMQ_ADMIN_ACCESS_KEY=flowdeskmqadmin
FLOWDESK_ROCKETMQ_ADMIN_SECRET_KEY=ReplaceWithRandomAdminSecret2026
FLOWDESK_ROCKETMQ_INNER_ACCESS_KEY=flowdeskbrokerinner
FLOWDESK_ROCKETMQ_INNER_SECRET_KEY=ReplaceWithRandomInnerSecret2026
FLOWDESK_TICKET_ROCKETMQ_ACCESS_KEY=flowdeskticket
FLOWDESK_TICKET_ROCKETMQ_SECRET_KEY=ReplaceWithRandomTicketSecret2026
FLOWDESK_TICKET_OUTBOX_PUBLISHER_ENABLED=false
FLOWDESK_TICKET_WORKFLOW_REVERSE_CONSUMER_ENABLED=false
FLOWDESK_WORKFLOW_ROCKETMQ_ACCESS_KEY=flowdeskworkflow
FLOWDESK_WORKFLOW_ROCKETMQ_SECRET_KEY=ReplaceWithRandomWorkflowSecret2026
FLOWDESK_WORKFLOW_START_CONSUMER_ENABLED=false
FLOWDESK_WORKFLOW_OUTBOX_PUBLISHER_ENABLED=false
FLOWDESK_ROCKETMQ_M7_ENABLED=true
FLOWDESK_ALERT_ROCKETMQ_ACCESS_KEY=flowdeskalert
FLOWDESK_ALERT_ROCKETMQ_SECRET_KEY=ReplaceWithRandomAlertSecret2026
FLOWDESK_ALERT_WEBHOOK_ENABLED=true
FLOWDESK_ALERT_WEBHOOK_TIMESTAMP_WINDOW=PT5M
FLOWDESK_ALERT_WEBHOOK_SECRETS_FILE=.data/keys/webhook-secrets.json
FLOWDESK_ALERT_TICKET_RESULT_ENTRY_ENABLED=false
FLOWDESK_ALERT_TICKET_RESULT_CONSUMER_ENABLED=false
FLOWDESK_ALERT_OUTBOX_PUBLISHER_ENABLED=false
FLOWDESK_TICKET_INCIDENT_ENTRY_ENABLED=false
FLOWDESK_TICKET_INCIDENT_CONSUMER_ENABLED=false
FLOWDESK_TICKET_INCIDENT_RESULT_PUBLISHER_ENABLED=false
FLOWDESK_TICKET_INCIDENT_RETRY_DELAY_LEVEL=0
FLOWDESK_ROCKETMQ_M8_ENABLED=true
FLOWDESK_NOTIFICATION_ROCKETMQ_ACCESS_KEY=flowdesknotification
FLOWDESK_NOTIFICATION_ROCKETMQ_SECRET_KEY=ReplaceWithRandomNotificationSecret2026
FLOWDESK_NOTIFICATION_ENTRY_ENABLED=false
FLOWDESK_NOTIFICATION_CONSUMER_ENABLED=false
FLOWDESK_NOTIFICATION_RECOVERY_ENABLED=false
FLOWDESK_TICKET_NOTIFICATION_OUTBOX_PUBLISHER_ENABLED=false
FLOWDESK_WORKFLOW_NOTIFICATION_OUTBOX_PUBLISHER_ENABLED=false
FLOWDESK_TICKET_SLA_ENABLED=false
FLOWDESK_TICKET_SLA_SCANNER_ENABLED=false
FLOWDESK_TICKET_SLA_REBUILDER_ENABLED=false
FLOWDESK_TICKET_SLA_REDIS_ENABLED=false
FLOWDESK_GATEWAY_WEBHOOK_REQUIRE_TLS=true
FLOWDESK_GATEWAY_TLS_ENABLED=true
FLOWDESK_GATEWAY_TLS_KEY_STORE=/run/secrets/flowdesk-gateway-tls.p12
FLOWDESK_GATEWAY_TLS_KEY_STORE_FILE=.data/keys/gateway-local.p12
FLOWDESK_GATEWAY_TLS_KEY_STORE_PASSWORD=replace-with-keystore-password
FLOWDESK_GATEWAY_TLS_KEY_STORE_TYPE=PKCS12
FLOWDESK_REDIS_HOST=127.0.0.1
FLOWDESK_REDIS_PORT=6379
FLOWDESK_IAM_DB_URL="jdbc:mysql://127.0.0.1:3306/flowdesk_iam?sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
FLOWDESK_TICKET_DB_URL="jdbc:mysql://127.0.0.1:3306/flowdesk_ticket?sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
FLOWDESK_TICKET_IAM_SERVICE_TOKEN_FILE=.data/service-tokens/{tenantId}-flowdesk-ticket-service.jwt
FLOWDESK_WORKFLOW_IAM_SERVICE_TOKEN_FILE=.data/service-tokens/{tenantId}-flowdesk-workflow-service.jwt
FLOWDESK_IAM_SERVICE_JWT_ROTATION_ENABLED=true
FLOWDESK_IAM_SERVICE_JWT_EXIT_AFTER_ISSUE=false
FLOWDESK_IAM_SERVICE_JWT_MAPPINGS=12d7dca8-380c-5a6c-84ae-953502959486:flowdesk-ticket-service,978d86fe-2cb8-5d4b-9968-e2f738a5c3e2:flowdesk-ticket-service,12d7dca8-380c-5a6c-84ae-953502959486:flowdesk-workflow-service,978d86fe-2cb8-5d4b-9968-e2f738a5c3e2:flowdesk-workflow-service
FLOWDESK_IAM_SERVICE_JWT_OUTPUT_DIRECTORY=.data/service-tokens
FLOWDESK_SERVICE_JWT_TTL=PT30S
FLOWDESK_SERVICE_JWT_ROTATION_INTERVAL=PT10S
FLOWDESK_JWT_CLOCK_SKEW=PT2S
FLOWDESK_WORKFLOW_DB_URL="jdbc:mysql://127.0.0.1:3306/flowdesk_workflow?sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
FLOWDESK_ALERT_DB_URL="jdbc:mysql://127.0.0.1:3306/flowdesk_alert?sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
FLOWDESK_NOTIFICATION_DB_URL="jdbc:mysql://127.0.0.1:3306/flowdesk_notification?sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
FLOWDESK_NOTIFICATION_RECOVERY_DB_URL="jdbc:mysql://127.0.0.1:3306/flowdesk_notification?sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
FLOWDESK_NOTIFICATION_RECOVERY_DB_USERNAME=fd_notification_recovery
